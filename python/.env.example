# Recommended explicit provider configuration (use placeholders only)
CHAT_PROVIDER=qwen
CHAT_API_KEY=your-chat-api-key
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536

# Legacy compatibility configuration (not recommended)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Vector Store: chroma | pgvector
VECTOR_STORE_TYPE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# PGVector (if VECTOR_STORE_TYPE=pgvector)
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# Kafka (CDC)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API
API_HOST=0.0.0.0
API_PORT=8080

# MongoDB (LangGraph Checkpoint)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agenthub
