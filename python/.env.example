# Recommended explicit provider configuration (use placeholders only)
CHAT_PROVIDER=bailian
CHAT_API_KEY=your-chat-api-key
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen3.7-flash-2026-07-15
EMBEDDING_PROVIDER=qwen
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIMENSIONS=1024
CHROMA_COLLECTION_NAME=knowledge_chunks_qwen37_flash_1024
EMBEDDING_SPACE_ID=qwen:qwen3.7-text-embedding-flash:1024

# Bounded provider timeout policy. Extraction retries only the side-effect-free
# Chat call; an extraction failure never stages Chroma or Neo4j data.
CHAT_TIMEOUT_SECONDS=60
EXTRACTION_REQUEST_TIMEOUT_SECONDS=120
EXTRACTION_CHUNK_DEADLINE_SECONDS=180
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=900
EXTRACTION_MAX_ATTEMPTS=2
EXTRACTION_RETRY_BACKOFF_SECONDS=1

# Optional local reranker. Keep disabled unless the model already exists locally.
RERANK_ENABLED=false
RERANK_PROVIDER=disabled
RERANK_MODEL_PATH=path-to-local-bge-reranker
RERANK_DEVICE=auto
RERANK_BATCH_SIZE=4
RERANK_MAX_LENGTH=512
RERANK_INPUT_TOP_K=30
RERANK_OUTPUT_TOP_K=12
RERANK_TIMEOUT_SECONDS=10
RERANK_MAX_ATTEMPTS=2

# Legacy compatibility configuration (not recommended)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Vector Store: chroma | pgvector
VECTOR_STORE_TYPE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# PGVector (if VECTOR_STORE_TYPE=pgvector)
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# Kafka (CDC)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API
API_HOST=0.0.0.0
API_PORT=8080

# MongoDB (LangGraph Checkpoint)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=agenthub
